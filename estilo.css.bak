/* Variáveis CSS - Paleta de Cores */
:root {
    --cor-principal: rgb(143, 45, 36);
    --cor-principal-claro: rgb(180, 60, 48);
    --cor-secundaria: #C7005B;
    --cor-destaque: #D3075F;
    --cor-fundo-claro: #FFD8E8;
    --cor-fundo-claro-hover: #f8bbd0;
    --cor-ativo: #2ecc71;
    --cor-pausado: #f1c40f;
    --sombra-leve: 0px 10px 20px rgba(131, 40, 35, 0.1);
    --sombra-media: 0px 5px 80px rgba(131, 40, 35, 0.3);
    --sombra-forte: 10px 15px 0px rgba(211, 7, 95, 0.9);
    --raio-pequeno: 10px;
    --raio-medio: 15px;
    --raio-grande: 25px;
}

body {
    margin: 0;
    box-sizing: border-box; 
    font-family: Arial, Helvetica, sans-serif;
    background-image: linear-gradient(to right, rgb(255, 169, 204), rgb(255, 216, 232));
    display: flex;
    flex-direction: column;
    min-height: 100vh; 
}
.conteudo-principal {
    color: white;
    display: flex;
    justify-content: center; 
    align-items: center; 
    flex-grow: 1;
    padding: 40px 0;
    box-sizing: border-box;
    gap: 40px;
}

.conteudo-principal.flex-col {
    flex-direction: column;
    justify-content: flex-start;
}

/* Caixa base - reutilizável */
.box, .box2, .texto {
    color: white;
    background-color: var(--cor-principal);
    border-radius: var(--raio-grande);
    box-shadow: var(--sombra-media);
    text-align: center;
    position: relative;
}

.box {
    padding: 40px 30px;
    width: 30%;
    margin: 10px 0;
}

.box2 {
    padding: 100px 40px;
    width: 80%;
    box-shadow: var(--sombra-leve);
}

.box2-transparente {
    background-color: transparent;
    transition: all 0.3s ease;
    text-align: left;
    padding-top: 20px;
    width: 90%;
}

.box2-transparente .filtro-container {
    padding: 20px;
    background: rgba(255, 255, 255, 0.08);
}

.texto {
    background-color: var(--cor-destaque);
    padding: 40px;
    width: 35%;
}

.box h1, .box2 h1, .texto h1 {
    margin-top: -10px;
}

.img {
    background-color: transparent;
    padding: 0;
    border-radius: var(--raio-grande);
    box-shadow: var(--sombra-forte);
    width: 30%;
    text-align: center;
}   
.inputBox {
    display: flex;
    align-items: center;
    position: relative;
}
.inputUser {
    width: 100%;
    box-sizing: border-box;
    padding: 10px;
    margin: 10px 0;
    border: none;
    border-bottom: 2px solid var(--cor-secundaria);
    outline: none;
    color: var(--cor-secundaria);
    font-size: 15px;
    font-weight: bold;
    background-color: var(--cor-fundo-claro);
    letter-spacing: 2px;
}
.labelInput {
    position: absolute;
    top: 20px; 
    left: 10px;
    pointer-events: none;
    transition: .5s;
    color: var(--cor-secundaria);
    font-weight: bold;
}
.inputUser[required]:focus ~ .labelInput,
.inputUser[required]:valid ~ .labelInput,
.inputUser:not([required]):focus ~ .labelInput,
.inputUser:not([required]):not(:placeholder-shown) ~ .labelInput {
    top: -15px;
    font-size: 12px;
    color: white;
}
#data_nasc {
    border: none;
    padding: 8px;
    border-radius: var(--raio-pequeno);
    outline: none;
    font-size: 15px;
    background-color: var(--cor-fundo-claro);
}
.labelDataNasc {
    font-weight: bold;
}

/* ===== Botões ===== */
.btn, .btn2 {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    line-height: 1.2;
    background: var(--cor-secundaria);
    color: white;
    border: none;
    padding: 10px;
    border-radius: var(--raio-grande);
    cursor: pointer;
    font-weight: bold;
    transition: background-color 0.3s ease;
}

.btn {
    width: 80%;
    margin: 10px;
}

.btn2 {
    width: 10%;
}

.btn:hover, .btn2:hover {
    background: var(--cor-fundo-claro-hover);
}
/* ===== Links ===== */
a {
    color: white;
    text-decoration: none;
    transition: text-decoration 0.3s ease;
}

a:hover {
    text-decoration: underline;
}

/* ===== Tabelas ===== */
.table-container {
    max-height: 400px; 
}

.review-table,
.cart-table {
    width: 100%;
    background: var(--cor-fundo-claro);
    border-collapse: collapse;
    margin-top: 20px;
    border: 2px solid var(--cor-principal);
}

.review-table th,
.review-table td,
.cart-table th,
.cart-table td {
    border: 1px solid var(--cor-principal);
    padding: 12px;
    text-align: left;
}

.review-table td,
.cart-table td {
    color: var(--cor-principal);
}

.review-table th,
.cart-table th {
    background: var(--cor-secundaria);
    color: white;
}

.cart-table tbody tr:nth-child(even) {
    background: rgba(255, 255, 255, 0.06);
}

.review-info {
    background: white;
    color: var(--cor-principal);
    padding: 20px;
    border-radius: var(--raio-medio);
    box-shadow: var(--sombra-leve);
    margin-top: 20px;
}

.review-info p {
    margin: 8px 0;
}

.btn-inline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    min-width: 180px;
}

/* ===== Cabeçalho ===== */
.cabecalho {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 50px;
    background-color: var(--cor-principal);
    box-shadow: var(--sombra-media);
}

.logo img {
    height: 80px;
    width: auto;
    display: block;
}

.menu-navegacao {
    display: flex;
    gap: 25px;
    align-items: center;
    text-decoration: none;
}

.menu-navegacao a {
    background-color: var(--cor-principal);
    color: white;
    padding: 8px 10px;
    border-radius: 20px;
    transition: background-color 0.3s ease;
}

.menu-navegacao a:hover {
    background-color: var(--cor-principal-claro);
    color: white;
}
/* ===== Status e Atributos ===== */
.linha-pausada {
    opacity: 0.5;
}

.status-badge {
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: bold;
}

.status-badge.ativo { 
    color: var(--cor-ativo); 
}

.status-badge.pausado { 
    color: var(--cor-pausado); 
}

/* ===== Filtros e Categorias ===== */
.filtro-container {
    display: flex;
    gap: 15px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
}

.categoria-bloco {
    text-align: left;
    margin-top: 15px;
    background: rgba(255, 255, 255, 0.08);
    padding: 15px;
    border-radius: var(--raio-medio);
}

.categoria-bloco span {
    font-size: 14px;
    display: block;
    margin-bottom: 5px;
}

.grupo-checkboxes {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin: 15px 0;
}

/* ===== Cadastro ===== */
.box-cadastro {
    width: 50%;
    padding: 40px;
}
/* ===== Imagens ===== */
.img-tabela {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: var(--raio-pequeno);
    display: block;
    margin: auto;
}

.card-img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: var(--raio-medio);
    margin-bottom: 10px;
    border: 1px solid var(--cor-principal);
}

.produto-card-cliente {
    min-height: 430px;
    padding: 20px;
    gap: 10px;
    background-color: var(--cor-fundo-claro);
    border-radius: var(--raio-grande);
    border: none;
    box-shadow: 0px 10px 20px rgba(199, 0, 90, 0.5);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.3s ease;
}

.produto-card-cliente .card-img {
    height: 220px;
}

.modal-box img {
    width: 100%;
    max-width: 320px;
    height: 320px;
    object-fit: cover;
    margin: 0 auto 20px;
    display: block;
}

/* ===== Cards de Produtos ===== */
.card-nome {
    font-size: 16px;
    font-weight: bold;
    color: var(--cor-secundaria);
    margin-bottom: 5px;
}

.card-preco {
    font-size: 18px;
    font-weight: bold;
    color: var(--cor-principal);
}

.produto-card-cliente {
    background-color: var(--cor-fundo-claro);
    padding: 15px;
    border-radius: var(--raio-grande);
    border: none;
    box-shadow: 0px 10px 20px rgba(199, 0, 90, 0.5);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.3s ease;
}

.produto-card-cliente:hover {
    transform: translateY(-8px);
    box-shadow: 0px 10px 20px rgba(199, 0, 90, 0.5);
}

/* ===== Categorias Cliente ===== */
.categoria-titulo-cliente {
    color: var(--cor-secundaria);
    text-align: left;
    margin-top: 0;
    font-size: 24px;
    padding-bottom: 5px;
    display: inline-block;
}

.produtos-grid-cliente {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 25px;
    width: 100%;
    margin-top: 20px;
}

/* ===== Modal sem JavaScript ===== */
.modal-checkbox {
    display: none;
}

.produto-card-container {
    position: relative;
}

.modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 50;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modal-checkbox:checked + .produto-card-container .modal-overlay {
    display: flex;
}

.modal-box {
    width: min(600px, 100%);
    background: white;
    color: var(--cor-principal);
    border-radius: var(--raio-grande);
    padding: 25px;
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.2);
    max-height: 90vh;
    overflow: auto;
    position: relative;
}

.modal-close {
    position: absolute;
    right: 20px;
    top: 20px;
    width: 36px;
    height: 36px;
    font-size: 26px;
    line-height: 36px;
    text-align: center;
    border-radius: 50%;
    background: var(--cor-principal);
    color: white;
    cursor: pointer;
}

.descricao-modal {
    color: #422424;
    line-height: 1.7;
    margin: 18px 0;
}

.detalhes-modal {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: space-between;
    margin-bottom: 20px;
    color: var(--cor-principal);
    font-weight: bold;
}

.form-adicionar-modal {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: flex-start;
}

.quantidade-input {
    width: 80px;
    padding: 8px;
    border-radius: var(--raio-pequeno);
    border: 1px solid var(--cor-principal);
    outline: none;
}

.aviso-login {
    color: var(--cor-principal);
    margin-bottom: 15px;
}

.mensagem-alerta {
    background: rgba(255, 216, 232, 0.92);
    color: var(--cor-principal);
    padding: 14px 18px;
    border-radius: var(--raio-medio);
    margin: 18px 0;
    width: 90%;
    max-width: 900px;
    text-align: center;
    box-shadow: var(--sombra-leve);
}

.cart-table {
    width: 100%;
    border-collapse: collapse;
}

.cart-table th,
.cart-table td {
    border: 1px solid var(--cor-principal);
    padding: 12px;
    text-align: left;
}

.cart-table img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: var(--raio-pequeno);
}

.cart-table tbody tr:nth-child(even) {
    background: rgba(255, 255, 255, 0.06);
}

.quantidade-form {
    display: grid;
    gap: 8px;
}

.btn-pequeno {
    width: auto;
    padding: 8px 12px;
}

.cart-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(199, 0, 90, 0.15);
}

.cart-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.cart-actions .btn,
.btn-inline {
    min-width: 180px;
}

.cart-total {
    font-size: 20px;
    color: var(--cor-principal);
}

.cart-empty {
    text-align: center;
    margin: 40px 0;
    color: var(--cor-principal);
}

@media (max-width: 860px) {
    .produtos-grid-cliente {
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }

    .cabecalho {
        flex-direction: column;
        gap: 12px;
        padding: 20px;
    }

    .menu-navegacao {
        flex-wrap: wrap;
        justify-content: center;
    }

    .box, .box2, .texto {
        width: 90%;
    }

    .cart-footer {
        flex-direction: column;
        align-items: stretch;
    }
}
